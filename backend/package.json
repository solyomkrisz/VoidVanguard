{
  "name": "voidvanguard-backend",
  "version": "1.0.0",
  "description": "Backend for VoidVanguard game",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --testTimeout=10000",
    "start": "node server.js",
    "dev": "nodemon"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ],
    "setupFiles": [
      "./test/jest.setup.js"
    ],
    "clearMocks": true
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "express-validator": "7.3.1",
    "fast-json-stable-stringify": "^2.1.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.0.2",
    "mysql2": "3.16.3",
    "nodemailer": "^8.0.5",
    "rate-limiter-flexible": "^11.0.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.3",
    "babel-jest": "^30.3.0",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
